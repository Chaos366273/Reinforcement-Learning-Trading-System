{
  "title": "PathRise training plan",
  "description": "The only plan object the form, Clawbot tools, and the training worker share. A run snapshots this document and does not edit it.",
  "type": "object",
  "required": ["style", "risk", "budget", "names", "cap", "stop", "halt", "mentor"],
  "properties": {
    "style": { "enum": ["cautious", "balanced", "bold"], "label": "Style", "simple": true },
    "risk": { "type": "integer", "minimum": 1, "maximum": 5, "label": "Risk comfort", "simple": true },
    "budget": { "enum": ["quick", "standard", "deep"], "label": "Budget", "simple": true },
    "names": { "type": "array", "minItems": 4, "maxItems": 30, "items": { "type": "string" }, "label": "Universe" },
    "cap": { "type": "number", "minimum": 5, "maximum": 15, "unit": "%", "label": "Position cap" },
    "stop": { "type": "number", "minimum": 4, "maximum": 12, "unit": "%", "label": "Trailing stop" },
    "halt": { "type": "number", "minimum": 8, "maximum": 25, "unit": "%", "label": "Session halt" },
    "mentor": { "enum": ["rules", "trend", "none"], "label": "Mentor" },
    "lr": { "type": "number", "minimum": 0.00005, "maximum": 0.001, "label": "Learning rate", "pro": true },
    "nSteps": { "type": "integer", "minimum": 512, "maximum": 8192, "label": "Rollout steps", "pro": true },
    "batch": { "type": "integer", "minimum": 64, "maximum": 2048, "label": "Batch", "pro": true },
    "gamma": { "type": "number", "minimum": 0.9, "maximum": 0.999, "label": "Gamma", "pro": true },
    "entropy": { "type": "number", "minimum": 0, "maximum": 0.1, "label": "Entropy coef", "pro": true },
    "clip": { "type": "number", "minimum": 0.05, "maximum": 0.3, "label": "Clip range", "pro": true },
    "tcnDepth": { "type": "integer", "minimum": 2, "maximum": 6, "label": "TCN depth", "pro": true },
    "seed": { "type": "integer", "minimum": 0, "maximum": 99999, "label": "Seed", "pro": true },
    "holdPenalty": { "type": "number", "minimum": -0.5, "maximum": 0, "label": "Hold penalty", "pro": true },
    "tradeIncentive": { "type": "number", "minimum": 0, "maximum": 2, "label": "Trading incentive", "pro": true }
  }
}
